{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "tradingview-official": {
        "type": "remote",
        "url": "https://mcp.tradingview.com/mcp",
        "disabled": true,
        "timeout": 15000
      },
      "binance-official": {
        "type": "remote",
        "url": "https://agent.binance.com/mcp/agentic",
        "disabled": true,
        "timeout": 15000
      }
    }
  }
}
